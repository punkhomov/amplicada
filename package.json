{
  "name": "amplicada",
  "private": true,
  "version": "0.0.0",
  "description": "Платформа оценки персонала с модульной архитектурой",
  "scripts": {
    "dev": "turbo dev --filter=@amplicada/api --filter=@amplicada/web",
    "infra:up": "docker compose -f docker-compose.infra.yaml up -d --wait",
    "infra:down": "docker compose -f docker-compose.infra.yaml down",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check:biome": "biome check --write .",
    "check:depcruise": "depcruise packages apps",
    "modules:generate": "turbo build --filter=@amplicada/application-tools && pnpm --filter @amplicada/api generate && pnpm --filter @amplicada/web generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dependency-cruiser": "^18.2.0",
    "skills": "^1.5.22",
    "turbo": "^2.10.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.0.0"
  }
}
