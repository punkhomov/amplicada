NODE_ENV=development
DATABASE_URL=postgresql://amplicada:amplicada@127.0.0.1:5432/amplicada
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=dev-session-secret-at-least-32-chars-local
# Метод аутентификации узла. Если не задан и метод в сборке один — берётся он.
AUTH_METHOD=password
# Внешний метод без модуля (kerberos-портал, SSO): узел редиректит неавторизованных туда.
# AUTH_LOGIN_URL=https://idp.example.local/kerberos
# AUTH_LOGOUT_URL=https://idp.example.local/logout
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=amplicada
S3_ACCESS_KEY_ID=amplicada
S3_SECRET_ACCESS_KEY=amplicada

# SMTP. Dev-почта — Mailpit из docker-compose.infra.yaml, UI на http://127.0.0.1:8025.
# Без SMTP_HOST узел стартует без почтового канала: уведомления не доставляются, это штатный режим.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Amplicada <no-reply@amplicada.local>
# SMTP_USER=
# SMTP_PASSWORD=

# Уведомления (дефолты совпадают со значениями ниже).
# NOTIFICATION_MAX_ATTEMPTS=5
# NOTIFICATION_RETRY_BASE_MS=30000
# NOTIFICATION_RETENTION_DAYS=30
