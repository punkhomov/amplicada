NODE_ENV=development
DATABASE_URL=postgresql://amplicada:amplicada@127.0.0.1:5432/amplicada
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=dev-session-secret-at-least-32-chars-local
# Метод аутентификации узла. Если не задан и метод в сборке один — берётся он.
AUTH_METHOD=password
# Внешний метод без модуля (kerberos-портал, SSO): узел редиректит неавторизованных туда.
# AUTH_LOGIN_URL=https://idp.example.local/kerberos
# AUTH_LOGOUT_URL=https://idp.example.local/logout
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=amplicada
# Соль псевдонимизации метрик: HMAC-секрет для обезличивания акторов (152-ФЗ).
# В продакшене задать случайным значением ≥ 32 символов и не ротировать без необходимости.
AMPLICADA_METRICS_PSEUDONYM_SALT=dev-metrics-pseudonym-salt-32-chars-min
# HMAC-секрет подписи webhook-доставки метрик (заголовок x-metrics-signature). Не задан — без подписи.
# AMPLICADA_METRICS_WEBHOOK_SECRET=dev-metrics-webhook-secret
S3_ACCESS_KEY_ID=amplicada
S3_SECRET_ACCESS_KEY=amplicada
