{
  "$schema": "https://turbo.build/schema.json",
  // Turborepo 2 по умолчанию работает в strict env mode: задача видит только те переменные, которые
  // объявлены в `env`/`passThroughEnv`, и ничего больше. Для нас это неверная модель — turbo здесь
  // запускалка задач, а не супервизор процесса: конфигурация приложения целиком приезжает из
  // окружения (docker compose, оболочка), и решать за него, какие из собственных переменных ему
  // видно, turbo не должен.
  //
  // Пряталось это долго и молча: значения в `docker-compose.dev.yaml` совпадали с дефолтами в коде
  // (`DATABASE_URL`, `REDIS_URL`, `S3_*`), поэтому вырезание переменных ничего не меняло. Первым
  // вылезло `SESSION_SECRET` — из него выводится ключ подписи токенов контента, и дефолта у него
  // намеренно нет. Явный список `passThroughEnv` эту ловушку не убирает, а воспроизводит: забытая
  // переменная снова тихо подменяется дефолтом.
  //
  // На кэш это не влияет: `build` и `typecheck` — это `tsc`, `test` — `node --test` по `dist`,
  // окружение не читает ни один из них. `dev` не кэшируется вовсе.
  "envMode": "loose",
  // `dev` — persistent-задача в каждом пакете, и turbo требует concurrency строго больше их числа,
  // иначе все слоты заняты watcher'ами и очередь не двигается. Дефолтных 10 перестало хватать, когда
  // пакетов с `dev` стало 11. Значение с запасом и здесь, а не флагом в скрипте: `pnpm dev` и
  // `command:` в docker-compose.dev.yaml зовут turbo по отдельности и разъехались бы.
  //
  // На остальные задачи это влияет слабо: `build`/`typecheck` идут по графу (`dependsOn: ["^build"]`),
  // и одновременно готовых к запуску пакетов там меньше двадцати.
  "concurrency": "20",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    }
  }
}
